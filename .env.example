# Required: Supabase Configuration
# Get these from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-anon-key

# Server Port (Render sets this automatically)
PORT=3000

# Bot Profile & AI Configuration
AI_NAME=Ayush AI
AI_MODEL=openai/gpt-oss-120b
AI_PROXY_URL=https://groq-proxy.mr-hackerdon808.workers.dev/
MAX_HISTORY=10

# Optional: Sightengine Image Moderation & Analysis API
# Get free API credentials from https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Rate Limits (Requests per minute per user)
AI_RATE_LIMIT=10
MEDIA_RATE_LIMIT=3

# File Limits & Storage Paths
MAX_IMAGE_SIZE=10485760
MAX_DOCUMENT_SIZE=20971520
SESSION_DIR=./auth_session
TEMP_DIR=./temp
